# Ethos environment variables.
# Copy to .env and fill in your keys. .env is gitignored. Never commit secrets.
# Execution authorization is set in the parent process, not this file:
# ETHOS_EXEC_BACKEND=docker and ETHOS_EXEC_IMAGE=<repository@sha256:digest>
# See docs/container-execution.md. Commands default to disabled.

# LLM Provider API Keys (set the one matching your provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Ollama (local inference — no key needed, just the host)
OLLAMA_HOST=http://localhost:11434

# Spider Cloud API (web fetch / scraping)
SPIDER_API_KEY=

# PostgreSQL (optional, for persistent session storage)
DATABASE_URL=postgresql://ethos:ethos@localhost:5432/ethos
