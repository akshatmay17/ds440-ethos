{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ethos",
  "version": "0.1.0",
  "identifier": "com.ethos.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Ethos - Agent Sandbox Runtime & Telemetry",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8000 ws://localhost:8000; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A Taint-Tracked Sandbox Runtime & Desktop Dashboard",
    "longDescription": "Ethos is a sandboxed runtime and agent-computer interface with taint analysis, live policy guardrails, and telemetry dashboard.",
    "copyright": "Copyright © 2026 Group 2 Nittany Street",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "entitlements": null
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": ["en-US"]
      }
    }
  }
}
